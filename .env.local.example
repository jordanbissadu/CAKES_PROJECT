# IDI's Cakes — environment variables
# Copy to `.env.local` and fill in from your Supabase project settings.

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: used by the public order Server Action to insert orders,
# bypassing RLS. NEVER expose this to the browser / prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (used for metadata / links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Order notifications (OPTIONAL) ---
# If set, an email is sent to the bakery on each new web order (via Resend).
# Leave empty to disable — orders still work, just without email.
RESEND_API_KEY=
ORDER_FROM_EMAIL=IDI's Cakes <no-reply@ton-domaine.com>
# Recipient. Falls back to the email set in dashboard Réglages if empty.
ORDER_NOTIFY_EMAIL=
